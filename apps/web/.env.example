# Faena360 - Environment Variables Template
# ==========================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it is already ignored.
# NEVER commit real credentials to any tracked file.
#
# For local development:
#   cp apps/web/.env.example apps/web/.env.local
#
# For production/staging:
#   These values live in the Vercel Dashboard only.
#   Go to: Vercel → Project → Settings → Environment Variables

# Supabase (public — these end up in the client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secrets (never expose these to browser code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WEBHOOK_WHATSAPP_SECRET=placeholder-webhook-whatsapp-secret
